+    if(!t.canAttack() && t!=Protoss_Reaver && t!=Protoss_Carrier) return 0;
+    if(t==Protoss_Zealot) return 2.0;
+    if(t==Protoss_Dragoon) return 3.0;
+    if(t==Protoss_Reaver) return 7.0;
+    if(t==Protoss_Dark_Templar) return 3.5;
+    if(t==Protoss_Archon) return 6.0;
+    return std::max(0.5,(t.mineralPrice()+t.gasPrice())/60.0);
+  }
+  double rememberedEnemyPower() const {
+    double sum=0;
+    for(const auto &e:enemyArmyMemory) if(frame-e.second.second<3600) sum+=typeValue(e.second.first);
+    return sum;
+  }
